--- a/config/version.mk
+++ b/config/version.mk
@@ -38,8 +38,7 @@ LINEAGE_VERSION := $(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(LINEAGE_V
